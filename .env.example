# Application
APP_PORT=3100
APP_ENV=development
API_KEY=your-secret-api-key-change-this

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=whatsapp_gateway



# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Anti-Ban Settings
DELAY_MIN=20
DELAY_MAX=90
BATCH_SIZE=40
REST_MIN=600
REST_MAX=1200
DAILY_LIMIT=200

# Webhook (callback ke Laravel setelah kirim)
WEBHOOK_URL=
WEBHOOK_SECRET=
